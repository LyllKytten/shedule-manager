# PostgreSQL (used by docker-compose for both the db and the api)
POSTGRES_USER=schedule
POSTGRES_PASSWORD=schedule
POSTGRES_DB=schedule

# Only needed when running the API outside docker-compose
DATABASE_URL=postgresql+psycopg://schedule:schedule@localhost:5432/schedule

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Superuser created on first start
SUPERUSER_USERNAME=harak1r1
SUPERUSER_PASSWORD=

ALLOW_REGISTRATION=true
CORS_ORIGINS=*
